# Neon PostgreSQL Connection URLs
# In production on Vercel: Provision Neon via Vercel Marketplace
# DATABASE_URL: Pooled connection string (Transaction mode, port 6543)
# DATABASE_URL_UNPOOLED: Direct connection string (Session mode, port 5432 for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Authentication Secret (min 32 chars)
JWT_SECRET=cinebook-super-secret-production-jwt-key-2026-xyz!

# Cron Secret for Vercel Cron scheduled hold releases
CRON_SECRET=cinebook_cron_secret_secure_key_9999

# Payment Webhook Secret
PAYMENT_WEBHOOK_SECRET=whsec_cinebook_test_key_live_2026

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
